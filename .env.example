# ============================================================================
# BOOKKARO Production Environment Variables Template (.env.example)
# ============================================================================

# Database Configuration (PostgreSQL 14+ with PostGIS extension)
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:<db_port>/bookkaro_db?schema=public"

# Cryptographic JWT Authentication Secrets (Must be 32+ character random strings)
JWT_ACCESS_SECRET="generate-a-secure-random-64-character-hex-string-for-access-token"
JWT_REFRESH_SECRET="generate-a-secure-random-64-character-hex-string-for-refresh-token"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Cookie Security & Domain Configuration
NODE_ENV="production"
COOKIE_DOMAIN=".bookkaro.in"
COOKIE_SECURE="true"

# Public Application URL & Standalone Backend Endpoint
NEXT_PUBLIC_APP_URL="https://bookkaro.in"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_USE_MOCK_API="false"

# Notification Gateways (Optional: Uses development fallback logger when omitted)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_SMS_WEBHOOK_URL="https://api.whatsapp-gateway.provider.com/v1/messages"
WHATSAPP_SMS_AUTH_TOKEN="Bearer <gateway-token>"
