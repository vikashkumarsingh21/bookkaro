# BOOKKARO Production Backend Configuration (Patna — Hotels, Dining & Salons)

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection (Prisma)
# Example: postgresql://postgres:postgres@localhost:5432/bookkaro_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookkaro_patna?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="bookkaro_super_secret_jwt_access_key_patna_2026_dev"
JWT_REFRESH_SECRET="bookkaro_super_secret_jwt_refresh_key_patna_2026_dev"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Razorpay Escrow Integration
RAZORPAY_KEY_ID="rzp_test_bookkaro_patna_dev"
RAZORPAY_KEY_SECRET="rzp_test_secret_patna_2026"
RAZORPAY_WEBHOOK_SECRET="whsec_patna_bookkaro_dev_2026"
RAZORPAY_MOCK_MODE=true
